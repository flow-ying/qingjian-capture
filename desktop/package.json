{
  "name": "apex-desktop-capture-orb",
  "version": "0.1.0",
  "private": true,
  "main": "demo/main.cjs",
  "scripts": {
    "build:desktop": "node scripts/build-standalone.cjs",
    "test:desktop": "node --test tests/standalone.test.cjs tests/standalone-bridge.test.cjs",
    "test:desktop-native": "node tests/standalone-native.cjs",
    "test:mobile-native": "node tests/mobile-native.cjs",
    "test": "node --test tests/*.test.cjs",
    "build": "node scripts/build.cjs",
    "test:windows": "node tests/windows.cjs",
    "demo": "electron .",
    "patch:check": "node scripts/prepare-integration.cjs",
    "format": "prettier --write src tests scripts demo ui package.json manifest.json",
    "verify": "node scripts/verify.cjs"
  },
  "devDependencies": {
    "@electron/remote": "2.1.3",
    "electron": "44.4.5",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "prettier": "3.6.2"
  }
}
