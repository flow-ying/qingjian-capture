# Copy to /etc/qingjian-relay.env (chmod 600) on your relay server
# Generate strong random tokens (>= 32 chars), e.g. `openssl rand -base64 36`
MOBILE_CAPTURE_DEVICE_TOKEN=replace-with-random-device-token-at-least-32-chars
MOBILE_CAPTURE_DESKTOP_TOKEN=replace-with-random-desktop-token-at-least-32-chars

MOBILE_CAPTURE_STATE_DIR=/var/lib/qingjian-relay
MOBILE_CAPTURE_HOST=127.0.0.1
MOBILE_CAPTURE_PORT=8941
MOBILE_CAPTURE_MAX_BLOB_BYTES=8388608
MOBILE_CAPTURE_MAX_STORE_BYTES=268435456
